{
  "entities": {
    "Receipt": {
      "title": "Kirana Khata Receipt",
      "description": "Store receipts, parchis, UPI settlements, and ledger entries.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "vendor": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 20 },
        "source": { "type": "string", "maxLength": 100 },
        "payment": { "type": "string", "maxLength": 50 },
        "paymentDetails": { "type": "string", "maxLength": 300 },
        "kind": { "type": "string", "enum": ["spent", "received"] },
        "conf": { "type": "number" },
        "status": { "type": "string", "enum": ["new", "accepted", "corrected", "dismissed"] },
        "dupOf": { "type": "string", "maxLength": 128 },
        "paidState": { "type": "string", "enum": ["paid", "unpaid", "partial"] }
      },
      "required": ["id", "vendor", "date", "kind", "status"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents registered user profile information.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 254 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "role", "createdAt"]
    },
    "Item": {
      "title": "Item",
      "description": "Store items and product inventory.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "draft", "archived"] },
        "price": { "type": "number" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "status", "createdAt"]
    }
  },
  "firestore": {
    "/receipts/{receiptId}": {
      "schema": "Receipt",
      "description": "Kirana Khata ledger transactions and receipts."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile store documents keyed by user UID."
    },
    "/items/{itemId}": {
      "schema": "Item",
      "description": "App inventory and items store."
    }
  }
}
